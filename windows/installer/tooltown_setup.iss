; Script generated by Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "The Mystery of Tooltown"
#define MyAppVersion "1.0 (Windows 11 Restored)"
#define MyAppPublisher "Scientific American Kids / Mindscape / Tooltown Community"
#define MyAppURL "https://github.com/mp-46/tooltown"
#define MyAppExeName "otvdm\otvdmw.exe"

[Setup]
AppId={{C8E19601-3829-4DA3-9118-8A9CD8B12F34}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=..\..\dist
OutputBaseFilename=MysteryOfTooltown_Setup
SetupIconFile=..\game\TOOL.ICO
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\game\TOOL.ICO
DisableProgramGroupPage=auto

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\game\*"; DestDir: "{app}\game"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\otvdm\*"; DestDir: "{app}\otvdm"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\Play Mystery of Tooltown.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Play Mystery of Tooltown.vbs"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Launch Manual.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\Launch Manual.vbs"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Parameters: """{app}\game\TOOL.EXE"""; WorkingDir: "{app}\game"; IconFilename: "{app}\game\TOOL.ICO"
Name: "{group}\Tooltown Electronic Manual"; Filename: "{app}\{#MyAppExeName}"; Parameters: """{app}\game\TTMANUAL.EXE"""; WorkingDir: "{app}\game"; IconFilename: "{app}\game\TOOL.ICO"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Parameters: """{app}\game\TOOL.EXE"""; WorkingDir: "{app}\game"; IconFilename: "{app}\game\TOOL.ICO"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Parameters: """{app}\game\TOOL.EXE"""; WorkingDir: "{app}\game"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent
